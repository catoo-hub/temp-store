{
  "name": "temp-store-ui",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/TempStore/Styles/app.css -o ./src/TempStore/wwwroot/app.css --minify",
    "watch:css": "tailwindcss -i ./src/TempStore/Styles/app.css -o ./src/TempStore/wwwroot/app.css --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@heroui/styles": "3.2.7",
    "@tailwindcss/cli": "4.2.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.2.1"
  }
}
