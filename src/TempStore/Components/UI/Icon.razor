<svg xmlns="http://www.w3.org/2000/svg"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.6"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     class="icon">
    @switch (Name)
    {
        case "bag":
            <path d="M6 7h12l2 14H4L6 7Z" />
            <path d="M9 8V6a3 3 0 0 1 6 0v2" />
            break;
        case "search":
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m16 16 4 4" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
            break;
        case "right":
            <path d="M4 12h16m-6-6 6 6-6 6" />
            break;
        case "left":
            <path d="M20 12H4m6-6-6 6 6 6" />
            break;
        case "chevron":
            <path d="m6 9 6 6 6-6" />
            break;
        case "close":
            <path d="m6 6 12 12M6 18 18 6" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "minus":
            <path d="M5 12h14" />
            break;
        case "check":
            <path d="m5 12 4 4L19 6" />
            break;
        case "menu":
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
        case "filter":
            <path d="M4 7h16M4 17h16" />
            <circle cx="8" cy="7" r="2" fill="currentColor" />
            <circle cx="16" cy="17" r="2" fill="currentColor" />
            break;
        case "star":
            <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" fill="currentColor" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v6M12 7h.01" />
            break;
        case "trash":
            <path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1 1M18 18l1 1M5 19l1-1M18 6l1-1" />
            break;
        case "moon":
            <path d="M20 15a9 9 0 0 1-11-11 9 9 0 1 0 11 11Z" />
            break;
        default:
            <circle cx="12" cy="12" r="8" />
            break;
    }
</svg>

@code
{
    [Parameter] public string Name { get; set; } = "info";
    [Parameter] public int Size { get; set; } = 20;
}
