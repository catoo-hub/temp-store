@page "/reviews"
@inject CatalogService Catalog

<PageTitle>Отзывы — ТЕМП</PageTitle>

<div class="container">
    <PageHeading Title="Отзывы" Description="О размерах, посадке и качестве одежды." />

    @if (Catalog.Reviews.Count == 0)
    {
        <EmptyState Title="Отзывов пока нет"
                    Description="Здесь появятся впечатления покупателей об одежде."
                    IconName="star" />
    }
    else
    {
        <div class="review-grid">
            @foreach (var review in Catalog.Reviews)
            {
                <ReviewCard Review="review" />
            }
        </div>
    }
</div>
