@page "/product/{Id:int}"
@inject CatalogService Catalog
@inject CartService Cart
@inject ToastService Toasts

<PageTitle>@(product?.Name ?? "Товар не найден") — ТЕМП</PageTitle>

<div class="container">
    @if (product is null)
    {
        <EmptyState Title="Товар не найден" Description="Возможно, ссылка устарела.">
            <a href="/catalog" class="button button--primary">Вернуться в каталог</a>
        </EmptyState>
    }
    else
    {
        <nav class="breadcrumb">
            <a href="/">Главная</a>
            <span>/</span>
            <a href="/catalog">Каталог</a>
            <span>/</span>
            <span>@product.Name</span>
        </nav>
        <div class="product-detail">
            <div class="detail-image">
                <img src="@product.Image" alt="@($"{product.Name}, {product.Color}")" width="600" height="690" />
            </div>
            <div class="detail-copy">
                <p class="eyebrow">@product.Brand · @product.Category</p>
                <h1>@product.Name</h1>
                <div class="row">
                    @if (product.IsNew)
                    {
                        <HChip Color="success">Новинка</HChip>
                    }
                    @if (product.Discount > 0)
                    {
                        <HChip Color="accent">Скидка @product.Discount%</HChip>
                    }
                </div>
                <div class="detail-price price">
                    @CatalogService.Money(product.Price)
                    @if (product.OldPrice.HasValue)
                    {
                        <del>@CatalogService.Money(product.OldPrice.Value)</del>
                    }
                </div>
                <p>Цвет: <strong>@product.Color</strong></p>
                <SizePicker Sizes="product.Sizes" @bind-Value="size" />
                <HButton FullWidth Size="lg" Disabled="@(size.Length == 0)" OnClick="Add">
                    @(size.Length == 0 ? "Выберите размер" : "Добавить в корзину") <Icon Name="bag" />
                </HButton>
                <HAccordion Title="О товаре" Open>
                    <p>
                        Модель: @product.Name. Бренд: @product.Brand.
                        Доступные размеры: @string.Join(", ", product.Sizes).
                    </p>
                </HAccordion>
                <HAccordion Title="Уход">
                    <p>Следуйте рекомендациям на ярлыке изделия.</p>
                </HAccordion>
            </div>
        </div>

        <section class="section">
            <div class="section-heading">
                <h2>Другие товары</h2>
                <a href="/catalog" class="text-link">Весь каталог <Icon Name="right" /></a>
            </div>
            <div class="product-grid">
                @foreach (var item in Catalog.Products.Where(x => x.Id != Id).Take(4))
                {
                    <ProductCard Product="item" @key="item.Id" />
                }
            </div>
        </section>
    }
</div>

@code
{
    [Parameter]
    public int Id { get; set; }

    private Product? product;
    private string size = "";

    protected override void OnParametersSet()
    {
        product = Catalog.Find(Id);
        size = "";
    }

    private async Task Add()
    {
        try
        {
            await Cart.AddAsync(Id, size);
            Toasts.Show("Товар добавлен в корзину");
        }
        catch (InvalidOperationException ex)
        {
            Toasts.Show(ex.Message, true);
        }
    }
}
