@page "/"
@inject CatalogService Catalog
@inject ToastService Toasts
<PageTitle>ТЕМП — магазин спортивной одежды</PageTitle>
    <section class="product-hero" aria-labelledby="hero-title">
        <div class="product-hero-copy">
            <h1 id="hero-title">Одежда<br />в твоём темпе</h1>
            <p>Для зала, пробежки и обычных дней.<br />Найди то, в чём тебе удобно.</p>
            <a href="/catalog" class="button button--primary button--lg">Смотреть каталог <Icon Name="right" /></a>
        </div>
        @for (var index = 0; index < heroProductIds.Length; index++)
        {
            var product = Catalog.Find(heroProductIds[index]);
            if (product is not null)
            {
                <a class="hero-product hero-product--@(index + 1)" href="/product/@product.Id" aria-label="@($"{product.Brand} {product.Name}, {CatalogService.Money(product.Price)}")" @key="product.Id">
                    <img src="@product.Image" alt="" width="400" height="500" decoding="async" />
                    <span>@product.Name</span>
                </a>
            }
        }
    </section>
<div class="container home-page">
    <nav class="category-index" aria-label="Категории одежды">
        @foreach (var category in Catalog.Categories)
        {
            <a href="@($"/catalog?category={Uri.EscapeDataString(category)}")">@category <span>@Catalog.Products.Count(x => x.Category == category)</span></a>
        }
    </nav>
    <section class="section">
        <div class="section-heading"><h2>Новинки</h2><a href="/new" class="text-link">Все новинки <Icon Name="right" /></a></div>
        <div class="product-grid">@foreach (var product in Catalog.Products.Where(x => x.IsNew).Take(4)) { <ProductCard Product="product" @key="product.Id" /> }</div>
    </section>
    <section class="sale-note">
        <div><span class="sale-note-label">Акции</span><h2>Одежда со скидкой</h2><p>Выбранные худи, футболки и брюки. Скидка уже учтена в цене.</p></div>
        <a href="/sale" class="button button--outline">Посмотреть @Catalog.Products.Count(x => x.Discount > 0) моделей <Icon Name="right" /></a>
    </section>
    <section class="section">
        <div class="section-heading"><h2>Популярные модели</h2><a href="/catalog" class="text-link">Весь каталог <Icon Name="right" /></a></div>
        <div class="product-grid">@foreach (var product in Catalog.Products.Where(x => x.Popular).Take(4)) { <ProductCard Product="product" @key="product.Id" /> }</div>
    </section>
    <section class="brand-directory">
        <h2>Бренды</h2><div>@foreach (var brand in Catalog.Brands) { <a href="@($"/catalog?brand={Uri.EscapeDataString(brand.Name)}")">@brand.Name <Icon Name="right" Size="16" /></a> }</div>
    </section>
    <section class="reviews-note"><div><h2>Отзывы</h2><p>Пока нет отзывов о покупках. Здесь появятся впечатления о размерах, посадке и качестве одежды.</p></div><a class="text-link" href="/reviews">Раздел отзывов <Icon Name="right" /></a></section>
    <section class="shop-about" id="about"><div><h2>О магазине</h2><p>В каталоге «ТЕМП» собраны футболки, худи, брюки и другая спортивная одежда. Товары можно отобрать по бренду, размеру и цене.</p><a href="/brands" class="text-link">Бренды в каталоге <Icon Name="right" /></a></div><div id="contacts"><h2>Написать нам</h2><p class="muted small">Задайте вопрос о товаре, размере или заказе.</p><FeedbackForm OnValidated="FeedbackValidated" /></div></section>
</div>
@code {
    private readonly int[] heroProductIds = [1, 2, 6, 5, 7, 3, 8, 4];
    private void FeedbackValidated(FeedbackModel model) => Toasts.Show("Не удалось отправить сообщение. Попробуйте позже.", true);
}
